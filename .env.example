# Скопируйте в .env и заполните то, что нужно. Все переменные необязательны.

# ---------------------------------------------------------------- доступ

# Пароль админ-панели (/admin). Если пусто — сгенерируется при первом запуске
# и сохранится в томе: docker compose exec backend cat /data/admin_password.txt
ADMIN_PASSWORD=

# Порт веб-интерфейса на хосте. За своим HTTPS-прокси — 127.0.0.1:8080
PORT=8080

# Только за своим прокси на том же сервере (см. docs/deploy.md): от кого nginx принимает
# X-Forwarded-For. 127.0.0.1 — никому не верить.
REAL_IP_FROM=127.0.0.1

# Мастер-ключ шифрования (email покупателей, пароли, токены): openssl rand -hex 32
# Задайте до первой регистрации и сохраните копию — сменить нельзя. Пусто — сгенерируется в томе data.
MASTER_KEY=

# ---------------------------------------------------------------- почта (подтверждение email, сброс пароля)

# Без SMTP_HOST письма не уходят, а пишутся в журнал бэкенда вместе со ссылкой.
# Яндекс: smtp.yandex.ru, 465, пароль приложения. Mail.ru: smtp.mail.ru, 465.
SMTP_HOST=
SMTP_PORT=465
# ssl (порт 465), starttls (порт 587) или none — только для отладки
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# Адрес и имя отправителя; адрес по умолчанию — SMTP_USER
MAIL_FROM=
MAIL_FROM_NAME=MonStoreLab

# ---------------------------------------------------------------- правила сервиса (страница /legal)

# Оператор персональных данных, как в документах: «ИП Иванов Иван Иванович, ИНН …, ОГРНИП …, адрес …»
LEGAL_OPERATOR=
# Почта для обращений по данным (отзыв согласия, удаление аккаунта); по умолчанию — MAIL_FROM
LEGAL_EMAIL=

# ---------------------------------------------------------------- экспертный разбор

# Ключ ProxyAPI (https://console.proxyapi.ru). Удобнее задать его в админ-панели:
# значение отсюда используется, только если в админке пусто.
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# Модели через запятую, формат vendor/model из каталога https://proxyapi.ru/models (до 6 штук)
EXPERT_MODELS=google/gemini-2.5-flash,anthropic/claude-haiku-4-5

# Сколько запросов к моделям выполнять одновременно
EXPERT_CONCURRENCY=6

# Модель визуального разбора «как арт-директор»; если не ответит — первая из EXPERT_MODELS
VISUAL_MODEL=anthropic/claude-sonnet-5-5

# Модель для улучшенной обложки (каталог https://proxyapi.ru/models, эндпоинт /images/edits)
IMAGE_MODEL=openai/gpt-image-2
# Качество генерации: medium (~14 ₽, ~30 с) или high (~51 ₽, ~75 с) — в превью разница почти не видна
IMAGE_QUALITY=medium

# ---------------------------------------------------------------- подписка: Точка Банк или ЮKassa

# Через кого принимать оплату: tochka или yookassa (не задано — Точка, если есть TOCHKA_JWT)
PAYMENT_PROVIDER=
# Точка Банк, интернет-эквайринг: JWT-ключ из интернет-банка (права на эквайринг), client_id приложения,
# код бизнес-клиента и торговая точка — см. docs/configuration.md
TOCHKA_JWT=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
# чек по 54-ФЗ через кассу Точки (по умолчанию 1); система налогообложения — пусто, как в кассе
TOCHKA_RECEIPT=1
TOCHKA_TAX_SYSTEM=

# ЮKassa

# Без этих двух ключей оплата выключена, все пользуются бесплатным тарифом.
# Цена, срок и лимиты — в админ-панели. Уведомления ЮKassa: https://ваш-домен/api/billing/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — отправлять чек по 54-ФЗ через ЮKassa
YOOKASSA_RECEIPT=0
# Адрес сайта: из него собираются ссылки в письмах, сюда платёжная страница вернёт покупателя
PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------- движок внимания

# 1 — образ с нейросетью DeepGaze IIE (скачивается ~1,5 ГБ, в работе ~1,3 ГБ памяти);
# 0 — лёгкий образ без неё
NEURAL=1

# 1 — в образе браузер для подбора конкурентов с Wildberries (~300 МБ); 0 — без него
MARKETPLACE=1

# auto — нейросеть, если она есть в образе; classic — всегда без нейросети
ENGINE=auto

# Длинная сторона картинки для нейросети, px. Больше — точнее и медленнее.
DEEPGAZE_SIDE=768

# Потоков для нейросети; 0 — подобрать по числу ядер
TORCH_THREADS=0

# ---------------------------------------------------------------- очередь тяжёлых задач

# Сколько задач каждой полосы выполняется одновременно, остальные ждут в очереди.
# Для сервера 4 CPU / 8 ГБ подходят значения по умолчанию.
QUEUE_NEURAL_WORKERS=2   # анализ и тест полки (нейросеть внимания)
QUEUE_AI_WORKERS=4       # визуальный разбор и выбор покупателя (запросы к ProxyAPI)
QUEUE_IMAGE_WORKERS=2    # генерация улучшенных обложек
QUEUE_BROWSER_WORKERS=1  # Chromium для подбора конкурентов с WB
# Задач одного покупателя в работе и ожидании; ожидающих в одной полосе — дальше «сервис перегружен»
QUEUE_PER_USER=8
QUEUE_MAX_WAITING=300

# Максимальный размер одного загружаемого файла, МБ
MAX_UPLOAD_MB=25
