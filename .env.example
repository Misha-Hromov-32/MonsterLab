# Скопируйте в .env и заполните то, что нужно. Все переменные необязательны.

# ---------------------------------------------------------------- доступ

# Пароль админ-панели (/admin). Если пусто — сгенерируется при первом запуске
# и сохранится в томе: docker compose exec backend cat /data/admin_password.txt
ADMIN_PASSWORD=

# Порт веб-интерфейса на хосте. За своим HTTPS-прокси — 127.0.0.1:8080
PORT=8080

# Только за своим прокси на том же сервере (см. docs/deploy.md): от кого nginx принимает
# X-Forwarded-For. 127.0.0.1 — никому не верить.
REAL_IP_FROM=127.0.0.1

# ---------------------------------------------------------------- экспертный разбор

# Ключ ProxyAPI (https://console.proxyapi.ru). Удобнее задать его в админ-панели:
# значение отсюда используется, только если в админке пусто.
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# Модели через запятую, формат vendor/model из каталога https://proxyapi.ru/models (до 6 штук)
EXPERT_MODELS=google/gemini-2.5-flash,anthropic/claude-haiku-4-5

# Сколько запросов к моделям выполнять одновременно
EXPERT_CONCURRENCY=6

# ---------------------------------------------------------------- движок внимания

# 1 — образ с нейросетью DeepGaze IIE (скачивается ~1,5 ГБ, в работе ~1,3 ГБ памяти);
# 0 — лёгкий образ без неё
NEURAL=1

# auto — нейросеть, если она есть в образе; classic — всегда без нейросети
ENGINE=auto

# Длинная сторона картинки для нейросети, px. Больше — точнее и медленнее.
DEEPGAZE_SIDE=768

# Потоков для нейросети; 0 — подобрать по числу ядер
TORCH_THREADS=0

# Потолок памяти контейнера бэкенда
BACKEND_MEM_LIMIT=1800m

# Максимальный размер одного загружаемого файла, МБ
MAX_UPLOAD_MB=25
