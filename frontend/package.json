    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
