    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
